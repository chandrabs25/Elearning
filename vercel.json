{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "cd elearning-platform && npm run build",
  "outputDirectory": "elearning-platform/.next",
  "installCommand": "cd elearning-platform && npm install",
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python@3.12",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "NEO4J_URI": "@neo4j_uri",
    "NEO4J_USER": "@neo4j_user",
    "NEO4J_PASSWORD": "@neo4j_password",
    "GROQ_API_KEY": "@groq_api_key",
    "GOOGLE_API_KEY": "@google_api_key"
  }
}
